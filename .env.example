# Cấu hình cổng & môi trường Backend (NestJS)
PORT=4000
NODE_ENV=development

# Kết nối cơ sở dữ liệu PostgreSQL (Prisma ORM)
DATABASE_URL=postgresql://brewlite:brewlite_dev_password@localhost:5436/brewlite?schema=public

# Cấu hình bảo mật JWT & CORS
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:3000

# Cấu hình Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cấu hình Cache phản hồi danh sách sản phẩm (ms)
PRODUCTS_CACHE_TTL_MS=30000
